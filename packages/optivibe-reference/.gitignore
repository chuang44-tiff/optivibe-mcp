# verbatim-local manual descriptions, so they too are user-built +
# gitignored — only the synonyms/semantics SOURCES are committed. Never committed:
# committing them would redistribute license-derived data.
src/optivibe_reference/data/glass_catalog.json
src/optivibe_reference/data/manual_manifest.json
src/optivibe_reference/data/operand_catalog.json
src/optivibe_reference/data/tolerance_operand_catalog.json
