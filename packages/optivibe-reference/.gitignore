# The manual FTS5 index is built locally from the install-dir PDF; the .db and any
# extracted manual prose stay out of the repo (no prose redistribution).
*.db
*.db-wal
*.db-shm
.scratch/
**/__pycache__/
*.pyc
.pytest_cache/

# User-built data JSONs — derived locally from YOUR licensed install by
